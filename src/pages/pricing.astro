---
import AppLayout from '../layouts/AppLayout.astro';
import SiteHeader from '../components/ui/SiteHeader';
import PricingSection from '../components/ui/PricingSection';
import { getLangFromUrl, useUiTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useUiTranslations(lang);
const pricingNav = t('nav.pricing');
---

<AppLayout title={`${pricingNav} | CV Studio`}>
  <SiteHeader lang={lang} client:only="react" />

  <div class="flex min-h-screen flex-col items-center justify-center pt-24 pb-16">
    <PricingSection lang={lang} client:only="react" />
  </div>
</AppLayout>
