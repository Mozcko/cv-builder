---
import Layout from './Layout.astro';
import GuestSync from '../components/auth/GuestSync';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <GuestSync client:only="react" />
  <div class="bg-app-bg flex h-screen flex-col overflow-y-auto">
    <slot />
  </div>
</Layout>
